<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IBudget.GUI.App"
			 xmlns:sty ="using:FluentAvalonia.Styling"
             xmlns:local="using:IBudget.GUI"
             Name="Stacks"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
		<sty:FluentAvaloniaTheme PreferUserAccentColor="True"/>
		<StyleInclude Source="avares://IBudget.GUI/Assets/Icons.axaml"/>
		<StyleInclude Source="avares://CalendarControl/Themes/Default.axaml" />
	</Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://IBudget.GUI/Assets/Styles/Tokens.axaml"/>
                <ResourceInclude Source="avares://IBudget.GUI/Assets/Styles/Controls.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>