<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IBudget.GUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="IBudget.GUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/stacks-logo.ico"
        Title="Stacks"
		MinWidth="600"
		MinHeight="400">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!-- Debug Banner -->
		<Border Grid.Row="0" Grid.ColumnSpan="2" Background="#FFFFBF00" IsVisible="{Binding DebugMode}" Height="32">
			<TextBlock Text="DEBUG MODE" Foreground="Black" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
		</Border>

		<!-- Side Panel -->
		<Border Grid.Column="0" 
			Grid.Row="1"
			Width="200"
			Background="{DynamicResource SurfaceBrush}"
			BorderBrush="{DynamicResource BorderBrush}"
			BorderThickness="0,0,1,0">
			<DockPanel Margin="0,16,0,0">

				<!-- Logo -->
				<Border DockPanel.Dock="Top" Margin="12,0,12,16"
						Background="{DynamicResource AccentBrush}"
						CornerRadius="7" Padding="12,8">
				<TextBlock Text="Stacks" Foreground="White" FontFamily="{StaticResource PlayfairDisplayFont}"
							FontSize="18" FontWeight="Bold"/>
				</Border>

				<!-- Theme toggle at bottom -->
				<Button DockPanel.Dock="Bottom" Margin="8,8,8,12"
						Background="{DynamicResource Surface2Brush}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1" CornerRadius="7" Padding="10,8"
						Cursor="Hand"
						HorizontalAlignment="Stretch"
						HorizontalContentAlignment="Stretch"
						Command="{Binding ThemeService.ToggleCommand}">
				<DockPanel LastChildFill="True">
					<TextBlock DockPanel.Dock="Right"
							Text="{Binding ThemeService.ThemeIcon}"
							VerticalAlignment="Center"
							FontSize="14"/>
					<TextBlock Text="{Binding ThemeService.ThemeLabel}"
							Foreground="{DynamicResource TextSecondary}"
							VerticalAlignment="Center"
							FontSize="12"/>
				</DockPanel>
				</Button>
				<!-- Nav groups -->
				<ScrollViewer VerticalScrollBarVisibility="Hidden">
				<StackPanel Margin="0,4,0,4">
					<TextBlock Text="OVERVIEW" Classes="NavLabel"/>
					<Button Classes="NavItem"
							Command="{Binding NavigateCommand}"
							CommandParameter="Dashboard"
							Content="Home"/>
					<Button Classes="NavItem NavItemAlert"
							Command="{Binding NavigateCommand}"
							CommandParameter="ReviewQueue"
							IsVisible="{Binding ReviewQueueCount, Converter={x:Static ObjectConverters.IsNotNull}}"
							Content="{Binding ReviewQueueCount,
										StringFormat='Review Queue ({0})'}"/>
					<TextBlock Text="MONEY" Classes="NavLabel"/>
					<Button Classes="NavItem" Command="{Binding NavigateCommand}" CommandParameter="Records"     Content="Records"/>
					<Button Classes="NavItem" Command="{Binding NavigateCommand}" CommandParameter="Goals Progress"       Content="Goals Progress"/>
					<Button Classes="NavItem" Command="{Binding NavigateCommand}" CommandParameter="Import"      Content="Import CSV"/>
					<TextBlock Text="CONFIG" Classes="NavLabel"/>
					<Button Classes="NavItem" Command="{Binding NavigateCommand}" CommandParameter="Rules"       Content="Rules"/>
					<Button Classes="NavItem" Command="{Binding NavigateCommand}" CommandParameter="Goals"       Content="Goals"/>
					<Button Classes="NavItem" Command="{Binding NavigateCommand}" CommandParameter="Tags"        Content="Tags"/>
					<Button Classes="NavItem" Command="{Binding NavigateCommand}" CommandParameter="Settings"        Content="Settings"/>
				</StackPanel>
				</ScrollViewer>
			</DockPanel>
		</Border>

		<!-- Main Content -->
		<Border Grid.Row="1" Grid.Column="1" CornerRadius="15 0 0 0">
			<TransitioningContentControl Content="{Binding CurrentPage}"/>
		</Border>
	</Grid>

</Window>
