<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IBudget.GUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="IBudget.GUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/stacks-logo.ico"
        Title="Stacks"
		MinWidth="600"
		MinHeight="400">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!-- Debug Banner -->
		<Border Grid.Row="0" Grid.ColumnSpan="2" Background="#FFFFBF00" IsVisible="{Binding DebugMode}" Height="32">
			<TextBlock Text="DEBUG MODE" Foreground="Black" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
		</Border>

		<!-- Side Panel -->
		<Border Grid.Column="0" 
			Grid.Row="1"
			Width="200"
			Background="{DynamicResource SideBarBg}"
			BorderBrush="{DynamicResource BorderBrush}"
			BorderThickness="0,0,1,0">
			<DockPanel Margin="0,16,0,0">

				<!-- Logo -->
				<Border DockPanel.Dock="Top" 
					Margin="12,0,12,16"
					Background="{DynamicResource AccentBrush}"
					CornerRadius="7" 
					Padding="12,8">
				<TextBlock Text="Stacks" 
					Foreground="White" 
					FontFamily="{StaticResource PlayfairDisplayFont}"
					FontSize="18" 
					FontWeight="Bold"/>
				</Border>

				<!-- Theme toggle at bottom -->
				<Button DockPanel.Dock="Bottom" 
					Margin="8,8,8,12"
					Background="{DynamicResource Surface2Brush}"
					BorderBrush="{DynamicResource BorderBrush}"
					BorderThickness="1" 
					CornerRadius="7" 
					Padding="10,8"
					Cursor="Hand"
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Stretch"
					Command="{Binding ThemeService.ToggleCommand}">
				<DockPanel LastChildFill="True">
					<TextBlock DockPanel.Dock="Right"
						Text="{Binding ThemeService.ThemeIcon}"
						VerticalAlignment="Center"
						FontSize="14"/>
					<TextBlock Text="{Binding ThemeService.ThemeLabel}"
						Foreground="{DynamicResource TextSecondary}"
						VerticalAlignment="Center"
						FontSize="12"/>
				</DockPanel>
				</Button>
				<!-- Nav groups -->
				<ScrollViewer VerticalScrollBarVisibility="Hidden">
				<StackPanel Margin="0,4,0,4">
					<StackPanel.Styles>
						<Style Selector="Button.isInactive">
							<Setter Property="Background"             Value="Transparent"/>
							<Setter Property="BorderBrush"            Value="Transparent"/>
							<Setter Property="BorderThickness"        Value="0"/>
							<Setter Property="Foreground"             Value="{DynamicResource TextPrimary}"/>
							<Setter Property="FontSize"               Value="13"/>
							<Setter Property="Padding"                Value="10,8"/>
							<Setter Property="Margin"                 Value="6,1,6,1"/>
							<Setter Property="CornerRadius"           Value="6"/>
							<Setter Property="HorizontalAlignment"    Value="Stretch"/>
							<Setter Property="HorizontalContentAlignment" Value="Left"/>
							<Setter Property="Cursor"                 Value="Hand"/>
							<Setter Property="Transitions">
								<Transitions/>
							</Setter>
						</Style>
						<Style Selector="Button.isInactive /template/ Border#PART_ContentBorder">
							<Setter Property="Background" Value="Transparent"/>
							<Setter Property="Transitions">
								<Transitions/>
							</Setter>
						</Style>
						<Style Selector="Button.isInactive:pointerover /template/ Border#PART_ContentBorder">
							<Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
						</Style>
						<Style Selector="Button.isInactive:pressed /template/ Border#PART_ContentBorder">
							<Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
						</Style>
						
						<Style Selector="Button.isActive">
							<Setter Property="Background"             Value="{DynamicResource SelectedBrush}"/>
							<Setter Property="BorderBrush"            Value="Transparent"/>
							<Setter Property="BorderThickness"        Value="0"/>
							<Setter Property="Foreground"             Value="{DynamicResource AccentLightBrush}"/>
							<Setter Property="FontSize"               Value="13"/>
							<Setter Property="Padding"                Value="10,8"/>
							<Setter Property="Margin"                 Value="6,1,6,1"/>
							<Setter Property="CornerRadius"           Value="6"/>
							<Setter Property="HorizontalAlignment"    Value="Stretch"/>
							<Setter Property="HorizontalContentAlignment" Value="Left"/>
							<Setter Property="Cursor"                 Value="Hand"/>
							<Setter Property="Transitions">
								<Transitions/>
							</Setter>
						</Style>
						<Style Selector="Button.isActive /template/ ContentPresenter">
							<Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
							<Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}"/>
							<Setter Property="Transitions">
								<Transitions/>
							</Setter>
						</Style>
						<Style Selector="Button.isActive:pointerover /template/ ContentPresenter">
							<Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
						</Style>
						<Style Selector="Button.isActive:pressed /template/ ContentPresenter">
							<Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
						</Style>
					</StackPanel.Styles>
					<TextBlock Text="OVERVIEW" Classes="NavLabel"/>
					<Button Classes.isActive="{Binding IsDashboardView}"
							Classes.isInactive="{Binding !IsDashboardView}"
							Command="{Binding NavigateCommand}"
							CommandParameter="Dashboard"
							Content="Dashboard"/>
					<Button Classes="NavItem NavItemAlert"
							Command="{Binding NavigateCommand}"
							CommandParameter="ReviewQueue"
							IsVisible="{Binding ReviewQueueCount, Converter={x:Static ObjectConverters.IsNotNull}}"
							Content="{Binding ReviewQueueCount,
										StringFormat='Review Queue ({0})'}"/>
					<TextBlock Text="MONEY" Classes="NavLabel"/>
					<Button Classes.isActive="{Binding IsRecordsView}"
							Classes.isInactive="{Binding !IsRecordsView}"
							Command="{Binding NavigateCommand}"
							CommandParameter="Records"
							Content="Records"/>
					<Button Classes.isActive="{Binding IsGoalsProgressView}"
							Classes.isInactive="{Binding !IsGoalsProgressView}"
							Command="{Binding NavigateCommand}"
							CommandParameter="Goals Progress"
							Content="Goals Progress"/>
					<Button Classes.isActive="{Binding IsImportCsvView}"
							Classes.isInactive="{Binding !IsImportCsvView}"
							Command="{Binding NavigateCommand}"
							CommandParameter="Import"
							Content="Import CSV"/>
					<TextBlock Text="CONFIG" Classes="NavLabel"/>
					<Button Classes.isActive="{Binding IsRulesView}" Classes.isInactive="{Binding !IsRulesView}" Command="{Binding NavigateCommand}" CommandParameter="Rules"       Content="Rules"/>
					<Button Classes.isActive="{Binding IsGoalsView}" Classes.isInactive="{Binding !IsGoalsView}" Command="{Binding NavigateCommand}" CommandParameter="Goals"       Content="Goals"/>
					<Button Classes.isActive="{Binding IsTagsView}" Classes.isInactive="{Binding !IsTagsView}" Command="{Binding NavigateCommand}" CommandParameter="Tags"        Content="Tags"/>
					<Button Classes.isActive="{Binding IsSettingsView}" Classes.isInactive="{Binding !IsSettingsView}" Command="{Binding NavigateCommand}" CommandParameter="Settings"        Content="Settings"/>
				</StackPanel>
				</ScrollViewer>
			</DockPanel>
		</Border>

		<!-- Main Content -->
		<Border Grid.Row="1" Grid.Column="1" CornerRadius="15 0 0 0">
			<TransitioningContentControl Content="{Binding CurrentPage}"/>
		</Border>
	</Grid>

</Window>
